# secrets
.env
.env.local
.env.*.local

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/

# local run state (never committed, wherever it's produced)
.census/
# a plain `census run --out results` at the repo root is a local test run;
# examples/*/results/ is different -- committed output, excepted below.
/results/

# data files are ignored by default -- a corpus a user points --input at is
# their own. The bundled demo corpus and the example corpora (T7.2, T7.3)
# are explicit, deliberate exceptions.
*.parquet
!src/jev_census/demo_data/**/*.parquet
!examples/**/*.parquet
